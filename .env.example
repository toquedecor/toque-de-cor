# ── Supabase (banco de dados gratuito) ───────────────────────────────────────
# Crie uma conta em https://supabase.com, crie um projeto e copie as chaves:
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── E-mail SMTP ───────────────────────────────────────────────────────────────
# Gmail: ative "Senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=seu.email@gmail.com
SMTP_SENHA=xxxx xxxx xxxx xxxx
SMTP_REMETENTE=Toque de Cor Pedidos
SMTP_DESTINATARIOS=compras@empresa.com,gerente@empresa.com

# ── Sessão ────────────────────────────────────────────────────────────────────
SESSION_HOURS=8

# ── Dados (opcional — deixe vazio para usar a pasta do app) ──────────────────
TOQUEDECOR_DATA_DIR=
